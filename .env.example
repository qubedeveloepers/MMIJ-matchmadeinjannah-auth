# Copy this file to .env and replace every placeholder locally.
# Never commit .env or paste its values into chat, issues, or logs.

DB_URL=<isolated-local-mongodb-url>
REDIS_HOST=<isolated-local-redis-host>
REDIS_PORT=<isolated-local-redis-port>

MAIL_HOST=<authorized-smtp-host>
MAIL_PORT=<465-or-587>
MAIL_SECURE=<true-or-false>
MAIL_USER=<authorized-smtp-username>
MAIL_PASSWORD=<authorized-smtp-password>
MAIL_FROM=<authorized-sender-address>

EMAIL_WHITELIST=<optional-non-otp-recipient-list>
NODE_ENV=<local-test-environment-name>
LOG_LEVEL=<local-log-level>
